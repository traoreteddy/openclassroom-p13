# Copier ce fichier vers .env puis adapter les valeurs

# Backend (FastAPI)
APP_NAME=P13 Chess Openings API
APP_ENV=development
API_V1_PREFIX=/api/v1
# Port exposé sur la machine hôte (le conteneur écoute toujours sur 8000)
BACKEND_PORT=8001

# MongoDB
MONGO_ROOT_USERNAME=p13
MONGO_ROOT_PASSWORD=change-me
MONGODB_DB_NAME=p13
# Port exposé sur la machine hôte (le conteneur écoute toujours sur 27017)
MONGO_PORT=27017
# Utilisée quand l'API tourne hors Docker ; dans Docker, l'URL pointe vers le service mongodb
MONGODB_URL=mongodb://p13:change-me@localhost:27017

# Outils de l'agent
# Jeton Lichess (obligatoire pour l'Opening Explorer) : https://lichess.org/account/oauth/token
LICHESS_TOKEN=
# Nombre minimal de parties pour considérer une position « en théorie »
THEORY_MIN_GAMES=20
# Chemin de l'exécutable Stockfish (dans Docker : /usr/games/stockfish)
STOCKFISH_PATH=stockfish
# Clé API YouTube Data v3 : https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# RAG
# Dans Docker, le backend utilise http://milvus:19530 (défini dans docker-compose.yml)
MILVUS_URI=http://localhost:19530
MILVUS_PORT=19530
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# LLM local : Ollama tourne sur la machine hôte (hors Docker, accès au GPU)
# Dans Docker, le backend utilise http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=phi4-mini
# Seuil de pertinence (calibré sur Réf-30 et Décision-50, voir docs/outil-rag.md)
RAG_MIN_SCORE=0.6
# Niveau de confidentialité maximal visible par l'agent : public, interne ou confidentiel
RAG_MAX_CONFIDENTIALITY=public
